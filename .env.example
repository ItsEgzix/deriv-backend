# App
NODE_ENV=development
PORT=3001

# Supabase Postgres (Prisma)
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase client (auth, storage, realtime, etc.)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Optional: server-side admin operations (never expose to clients)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
